{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": [],
    "target": "esnext",
    "module": "preserve",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["./**/*.ts", "./**/*.gts"]
}
