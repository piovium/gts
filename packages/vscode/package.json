{
  "private": true,
  "name": "gts-vscode",
  "version": "0.0.6",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/volarjs/starter.git",
    "directory": "packages/vscode"
  },
  "icon": "assets/icon.webp",
  "categories": [
    "Programming Languages"
  ],
  "displayName": "GamingTS Language Features",
  "description": "GamingTS Language Features",
  "author": "Piovium Labs",
  "publisher": "Guyutongxue",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "activationEvents": [
    "onLanguage:gaming-ts"
  ],
  "main": "./dist/extension.js",
  "exports": {
    ".": "./dist/extension.js",
    "./syntaxes": "./syntaxes/GamingTS.tmLanguage.json",
    "./language-configuration": "./language-configuration.json"
  },
  "scripts": {
    "build": "tsdown",
    "pack": "rimraf temp && pnpm pack --pack-destination temp/ && tar -xzf temp/*.tgz -C temp/ && cd temp/package && npm install --omit=dev && vsce package"
  },
  "dependencies": {
    "@gi-tcg/gts-typescript-language-service-plugin": "workspace:*"
  },
  "devDependencies": {
    "@gi-tcg/gts-language-server": "workspace:*",
    "@types/node": "^24.10.4",
    "@types/vscode": "^1.107.0",
    "@volar/language-server": "~2.4.0",
    "@volar/vscode": "~2.4.0",
    "fast-plist": "^0.1.3",
    "rimraf": "^6.1.3",
    "vsce": "latest"
  },
  "contributes": {
    "languages": [
      {
        "id": "gaming-ts",
        "aliases": [
          "GamingTS",
          "gaming-ts",
          "gts"
        ],
        "extensions": [
          ".gts"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./assets/file_type_gts.svg",
          "light": "./assets/file_type_gts.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "gaming-ts",
        "scopeName": "source.gts",
        "path": "./syntaxes/GamingTS.tmLanguage.json"
      }
    ],
    "typescriptServerPlugins": [
      {
        "name": "@gi-tcg/gts-typescript-language-service-plugin",
        "enableForWorkspaceTypeScriptVersions": true,
        "languages": []
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "package.json"
        ],
        "url": "./package-json-extra.schema.json"
      }
    ],
    "commands": [
      {
        "command": "gaming-ts.restart-server",
        "title": "GamingTS: Restart Language Server"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "gtsAttribute",
        "description": "Attribute name for GamingTS"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "gaming-ts",
        "scopes": {
          "*.gtsAttribute": [
            "emphasis"
          ]
        }
      }
    ]
  }
}
