{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "module": "NodeNext",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "sourceMap": true,
    "composite": true,

    "declaration": true,
    "emitDeclarationOnly": true,

    "strict": true,
    "skipLibCheck": true,
    "isolatedDeclarations": true,
  },
}
