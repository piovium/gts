{
  "name": "@gi-tcg/unplugin-gts",
  "version": "0.6.0",
  "repository": "https://github.com/piovium/gts.git",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": ["./src/index.ts", "./dist/index.js"],
      "default": "./dist/index.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "development": ["./src/bun.ts", "./dist/bun.js"],
      "default": "./dist/bun.js"
    },
    "./bun/preload": "./src/bun_preload.ts",
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "development": ["./src/esbuild.ts", "./dist/esbuild.js"],
      "default": "./dist/esbuild.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "development": ["./src/rolldown.ts", "./dist/rolldown.js"],
      "default": "./dist/rolldown.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "development": ["./src/rollup.ts", "./dist/rollup.js"],
      "default": "./dist/rollup.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "development": ["./src/rspack.ts", "./dist/rspack.js"],
      "default": "./dist/rspack.js"
    },
    "./unloader": {
      "types": "./dist/unloader.d.ts",
      "development": ["./src/unloader.ts", "./dist/unloader.js"],
      "default": "./dist/unloader.js"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.ts",
      "development": ["./src/unplugin.ts", "./dist/unplugin.js"],
      "default": "./dist/unplugin.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "development": ["./src/vite.ts", "./dist/vite.js"],
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "development": ["./src/webpack.ts", "./dist/webpack.js"],
      "default": "./dist/webpack.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "peerDependencies": {
    "@rspack/core": "^1",
    "esbuild": "*",
    "rollup": ">=3",
    "rolldown": "*",
    "vite": "*",
    "unloader": "*",
    "webpack": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "rolldown": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "unloader": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "dependencies": {
    "@gi-tcg/gts-transpiler": "workspace:*",
    "@types/bun": "^1.3.6",
    "unplugin": "npm:@gytx/unplugin@3.1.0-patch.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0"
  }
}
