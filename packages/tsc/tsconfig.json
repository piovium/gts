{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": ["node"],

    "module": "Preserve",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,

    "sourceMap": true,
    "composite": true,

    "declaration": true,
    "emitDeclarationOnly": true,

    "strict": true,
    "skipLibCheck": true
  },
}
