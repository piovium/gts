{
  "compilerOptions": {
    "target": "ES2021",
    "lib": [
      "ES2021",
    ],
    "module": "Preserve",
    "sourceMap": true,
    "composite": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,

    "strict": true,
    "skipLibCheck": true,
  },
  "include": [
    "src",
    "scripts"
  ],
}
