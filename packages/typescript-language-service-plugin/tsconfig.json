{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": ["node"],
    "module": "CommonJS",

    // "verbatimModuleSyntax": true,
    // "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "sourceMap": true,
    
    "composite": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["src"],
}
