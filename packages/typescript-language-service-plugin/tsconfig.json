{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": ["node"],
    "module": "NodeNext",

    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "sourceMap": true,
    
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "strict": true,
    "skipLibCheck": true,
  },
  "include": ["src"],
}
