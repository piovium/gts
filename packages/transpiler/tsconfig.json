{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "types": [],
    "module": "NodeNext",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,

    "sourceMap": true,
    "composite": true,

    "declaration": true,
    "emitDeclarationOnly": true,
    
    "isolatedDeclarations": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
